<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude code that belongs to separately-built class-library projects -->
    <Compile Remove="GeometryEngine\**\*.cs" />
    <Compile Remove="KinematicEngine\**\*.cs" />
    <Compile Remove="TCPServer\**\*.cs" />
    <ProjectReference Include="..\..\Libraries\SharedTypes\SharedTypes.csproj" />
    <ProjectReference Include="TCPServer\TCPServer.csproj" />
    <ProjectReference Include="KinematicEngine\KinematicEngine.csproj" />
    <ProjectReference Include="GeometryEngine\GeometryEngine.csproj" />
    <PackageReference Include="Avalonia" Version="11.0.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
