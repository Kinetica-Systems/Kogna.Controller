# Makefile for TCC compilation of Kogna UART Passthrough
# TCC (Tiny C Compiler) compatible build

# Compiler and flags
CC = tcc
CFLAGS = -Wall -O2
INCLUDES = -I.
LIBS = -lKMotion

# Target executable
TARGET = kogna_uart_passthrough.exe

# Source files
SOURCES = kogna_uart_passthrough_tcc.c

# Default target
all: $(TARGET)

# Compile the program
$(TARGET): $(SOURCES)
	$(CC) $(CFLAGS) $(INCLUDES) -o $(TARGET) $(SOURCES) $(LIBS)

# Clean build artifacts
clean:
	del /Q $(TARGET) 2>nul || true

# Install to Kogna (requires SCP)
install: $(TARGET)
	@echo "Copying $(TARGET) to Kogna..."
	@echo "Please manually copy $(TARGET) to your Kogna controller"
	@echo "or use the deploy script: deploy_to_kogna.bat"

# Test compilation
test: $(TARGET)
	@echo "Compilation successful: $(TARGET)"
	@echo "File size:"
	@dir $(TARGET) | findstr $(TARGET)

# Help
help:
	@echo "Available targets:"
	@echo "  all     - Build the executable (default)"
	@echo "  clean   - Remove build artifacts"
	@echo "  install - Install to Kogna (manual)"
	@echo "  test    - Test compilation"
	@echo "  help    - Show this help"

.PHONY: all clean install test help 